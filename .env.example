# ─────────────────────────────────────────────
# NursePrep — Environment Variables
# 1. Copy this file to .env on your VPS
# 2. Fill in your values
# 3. NEVER commit .env to git
# ─────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://nurseprep:yourpassword@localhost:5432/nurseprep

# Port the Node server listens on
PORT=3000

# From: Anthropic Console → API Keys (optional — enables AI test validation)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
